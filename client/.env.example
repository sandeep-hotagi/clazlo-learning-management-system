# Frontend Environment Variables Template
# For local development:
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000

# For Vercel Production Deployment:
# Set VITE_API_URL to your Render backend API URL (e.g., https://clazlo-server.onrender.com/api)
# Set VITE_SOCKET_URL to your Render backend root URL (e.g., https://clazlo-server.onrender.com)
