# Backend Environment Variables Template
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/clazlo?retryWrites=true&w=majority
JWT_SECRET=your_production_super_secret_jwt_key_here
CLIENT_ORIGIN=http://localhost:5176
SERVER_PUBLIC_URL=http://localhost:5000

# For Render Production Deployment:
# Set CLIENT_ORIGIN to your Vercel frontend URL (e.g., https://clazlo-lms.vercel.app)
# Set SERVER_PUBLIC_URL to your Render backend URL (e.g., https://clazlo-server.onrender.com)
